{
  "name": "gigooo-aiagent-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GIGOOO AI Agent Monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@gigooo/frontend",
    "dev:frontend": "npm run dev --workspace=@gigooo/frontend",
    "dev:backend": "cd packages/backend && uvicorn main:app --reload --port 8000",
    "build": "npm run build --workspace=@gigooo/frontend",
    "build:frontend": "npm run build --workspace=@gigooo/frontend",
    "preview": "npm run preview --workspace=@gigooo/frontend",
    "lint": "npm run lint --workspace=@gigooo/frontend",
    "install:backend": "cd packages/backend && pip install -r requirements.txt",
    "start:backend": "cd packages/backend && uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
